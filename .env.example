# Copy this file to .env and adjust as needed.
# (The app reads plain environment variables; python-dotenv is not a hard
# dependency, so either export these yourself or add python-dotenv if you
# want .env auto-loading.)

# Port the Flask app listens on
PORT=5000

# Set to 0 in production/Docker, 1 for local development (enables Flask's
# debug reloader and interactive debugger)
FLASK_DEBUG=1

# Confidence below this threshold triggers the fallback response instead
# of trusting the model's top prediction. Lower = bot guesses more often;
# higher = bot asks for clarification more often.
CONFIDENCE_THRESHOLD=0.35
